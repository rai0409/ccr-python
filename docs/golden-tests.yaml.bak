golden_test_spec_version: "1.0"

pytest_contract:
  runner:
    entrypoint: "ccr.cli.main.run_cli"
    cwd_root: "/tmp/ccr_ws"
    transcript_dir: "/tmp/ccr_sessions"
    config_dir: "/tmp/ccr_config"
    data_dir: "/tmp/ccr_data"
  determinism:
    clock:
      mode: "frozen_incremental"
      start_rfc3339: "2026-01-01T00:00:00.000000Z"
      step_ms: 1
    ids:
      session_id: ["S1", "S2", "S3"]
      run_id: ["R1", "R2", "R3"]
      event_id: "E{n}"
      record_id_rule: "record_id == event_id"
    randomness: "disabled"
  global_assertions:
    - "persisted records are append-only"
    - "seq is strictly increasing per session_id"
    - "parent_id == parent_event_id when parent exists"
    - "assistant_delta is never persisted"
    - "exactly one run terminal event per run_id"

tests:
  - test_name: cli_text_prompt_arg
    cli_input: ["ccr", "-p", "hello"]
    environment_state:
      permission_mode: "ask"
      input_mode: "text"
      output_format: "text"
      interactive_available: false
      model_script:
        - {emit: "assistant_message", content: "OK"}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, assistant_delta]
      - [4, assistant_message]
      - [5, session_completed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 1, type: session_start, run_id: "R1", parent_id: null}
        - {seq: 2, type: user_message, run_id: "R1", parent_id: "E1", payload: {content: "hello"}}
        - {seq: 4, type: assistant_message, run_id: "R1", parent_id: "E2", payload: {content: "OK"}}
        - {seq: 5, type: session_completed, run_id: "R1", parent_id: "E4", payload: {status: "completed"}}
      not_persisted_types: ["assistant_delta"]
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
      stdout_text: "OK\n"
      stderr_text: ""
      json_output: null
      stream_json: []
    allowed_variance:
      - "none (ids/time fixed by harness)"
    failure_conditions:
      - "missing/extra event"
      - "assistant_delta persisted"
      - "output text mismatch"

  - test_name: cli_text_prompt_stdin
    cli_input: ["ccr", "-p"]
    environment_state:
      stdin_text: "hello from stdin"
      permission_mode: "ask"
      input_mode: "text"
      output_format: "text"
      interactive_available: false
      model_script:
        - {emit: "assistant_message", content: "OK"}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, assistant_delta]
      - [4, assistant_message]
      - [5, session_completed]
    expected_jsonl_transcript_entries:
      include_from: "cli_text_prompt_arg"
      lines:
        - {seq: 2, type: user_message, payload: {content: "hello from stdin"}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
      stdout_text: "OK\n"
      stderr_text: ""
      json_output: null
      stream_json: []
    allowed_variance: ["none"]
    failure_conditions:
      - "stdin not consumed fully"
      - "event/persistence mismatch"

  - test_name: cli_json_output
    cli_input: ["ccr", "-p", "hello", "--output-format", "json"]
    environment_state:
      permission_mode: "ask"
      input_mode: "text"
      output_format: "json"
      interactive_available: false
      model_script:
        - {emit: "assistant_message", content: "OK"}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, assistant_delta]
      - [4, assistant_message]
      - [5, session_completed]
    expected_jsonl_transcript_entries:
      include_from: "cli_text_prompt_arg"
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
      stdout_text: ""
      stderr_text: ""
      json_output:
        exact_keys: ["status", "session_id", "run_id", "assistant_message"]
        exact_values:
          status: "completed"
          assistant_message:
            content: "OK"
      stream_json: []
    allowed_variance:
      - "session_id/run_id fixed by harness"
    failure_conditions:
      - "json shape mismatch"
      - "text printed in json mode"

  - test_name: cli_stream_json_basic
    cli_input: ["ccr", "-p", "--output-format", "stream-json", "--input-format", "stream-json"]
    environment_state:
      stdin_ndjson:
        - {"type": "user_message", "content": "hello"}
      permission_mode: "ask"
      interactive_available: true
      model_script:
        - {emit: "assistant_message", content: "OK"}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, assistant_delta]
      - [4, assistant_message]
      - [5, session_completed]
    expected_jsonl_transcript_entries:
      include_from: "cli_text_prompt_arg"
      lines_override:
        - {seq: 2, type: user_message, payload: {content: "hello", input_mode: "stream-json"}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
      stdout_text: ""
      stderr_text: ""
      json_output: null
      stream_json:
        ordered_types: ["session_start", "user_message", "assistant_delta", "assistant_message", "session_completed"]
        line_count: 5
    allowed_variance: ["none"]
    failure_conditions:
      - "stream order mismatch"
      - "non-ndjson line"
      - "delta persisted"

  - test_name: cli_invalid_flag_combo
    cli_input: ["ccr", "-p", "hello", "--input-format", "stream-json"]
    environment_state:
      parser_mode: "strict"
    transcript_pre_state: []
    expected_ordered_event_sequence: []
    expected_jsonl_transcript_entries:
      lines: []
    expected_tool_calls: []
    expected_outputs:
      exit_code: 2
      stdout_text: ""
      stderr_text_regex: "invalid flag combination"
      json_output: null
      stream_json: []
    allowed_variance:
      - "error text exact match required"
    failure_conditions:
      - "runtime started"
      - "any transcript write"
      - "wrong exit code"

  - test_name: cli_allowed_disallowed_precedence
    cli_input:
      - "ccr"
      - "-p"
      - "run status"
      - "--allowed-tools"
      - "Bash(git:*)"
      - "--disallowed-tools"
      - "Bash(git:*)"
      - "--output-format"
      - "stream-json"
      - "--input-format"
      - "stream-json"
    environment_state:
      stdin_ndjson:
        - {"type": "user_message", "content": "run status"}
      permission_mode: "ask"
      interactive_available: true
      model_script:
        - emit_tool:
            tool_name: "Bash"
            input:
              command: "git status --short"
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, tool_call_requested]
      - [4, tool_permission_decided]
      - [5, tool_result]
      - [6, tool_execution_finished]
      - [7, session_failed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 4, type: tool_permission_decided, payload: {decision: "deny", reason_code: "hard_boundary_tool_disallowed", precedence_rank: 1}}
        - {seq: 5, type: tool_result, payload: {result: {status: "denied"}}}
        - {seq: 7, type: session_failed, payload: {error_code: "PERMISSION_DENIED"}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 5
      stream_json:
        ordered_types: ["session_start", "user_message", "tool_call_requested", "tool_permission_decided", "tool_result", "tool_execution_finished", "session_failed"]
    allowed_variance: ["none"]
    failure_conditions:
      - "Bash executed"
      - "reason_code not hard_boundary_tool_disallowed"

  - test_name: cli_ask_unavailable_exit6
    cli_input: ["ccr", "-p", "do dangerous", "--permission-mode", "ask"]
    environment_state:
      permission_mode: "ask"
      input_mode: "text"
      output_format: "text"
      interactive_available: false
      model_script:
        - emit_tool:
            tool_name: "Bash"
            input:
              command: "git status"
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, tool_call_requested]
      - [4, tool_permission_decided]
      - [5, tool_result]
      - [6, tool_execution_finished]
      - [7, session_failed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 4, type: tool_permission_decided, payload: {decision: "deny", reason_code: "ask_unavailable", precedence_rank: 6}}
        - {seq: 5, type: tool_result, payload: {result: {status: "denied"}}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 6
      stdout_text: ""
      stderr_text_regex: "permission required but unavailable"
    allowed_variance: ["none"]
    failure_conditions:
      - "tool_permission_required emitted"
      - "wrong exit code"

  - test_name: stream_json_control_schema_validation
    cli_input: ["ccr", "-p", "--input-format", "stream-json", "--output-format", "stream-json"]
    environment_state:
      stdin_ndjson:
        - {"type": "bad_type", "x": 1}
      parser_mode: "strict"
    transcript_pre_state: []
    expected_ordered_event_sequence: []
    expected_jsonl_transcript_entries:
      lines: []
    expected_tool_calls: []
    expected_outputs:
      exit_code: 2
      stderr_text_regex: "unknown control message type"
      stream_json: []
    allowed_variance: ["none"]
    failure_conditions:
      - "runtime session_start emitted"
      - "transcript non-empty"

  - test_name: event_record_id_alignment
    cli_input: ["ccr", "-p", "hello"]
    environment_state:
      model_script:
        - {emit: "assistant_message", content: "OK"}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, assistant_delta]
      - [4, assistant_message]
      - [5, session_completed]
    expected_jsonl_transcript_entries:
      include_from: "cli_text_prompt_arg"
      assertions:
        - "for all lines: record_id == event_id"
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
      stdout_text: "OK\n"
    allowed_variance: ["none"]
    failure_conditions:
      - "any line record_id != event_id"

  - test_name: event_parent_id_alignment
    cli_input: ["ccr", "-p", "hello"]
    environment_state:
      model_script:
        - {emit: "assistant_message", content: "OK"}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, assistant_delta]
      - [4, assistant_message]
      - [5, session_completed]
    expected_jsonl_transcript_entries:
      include_from: "cli_text_prompt_arg"
      assertions:
        - "line1.parent_id is null"
        - "lineN.parent_id == previous persisted line record_id"
        - "lineN.parent_id == lineN.parent_event_id"
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
    allowed_variance: ["none"]
    failure_conditions:
      - "parent chain mismatch"
      - "cycle"

  - test_name: event_run_terminality_scope
    cli_input: ["ccr", "--continue", "-p", "next"]
    environment_state:
      model_script:
        - {emit: "assistant_message", content: "R2 OK"}
      session_index:
        - {cwd: "/tmp/ccr_ws", latest_session_id: "S1"}
    transcript_pre_state:
      - {session_id: "S1", run_id: "R1", seq: 1, type: "session_start"}
      - {session_id: "S1", run_id: "R1", seq: 2, type: "user_message"}
      - {session_id: "S1", run_id: "R1", seq: 3, type: "assistant_message"}
      - {session_id: "S1", run_id: "R1", seq: 4, type: "session_completed"}
    expected_ordered_event_sequence:
      - [5, session_resumed]
      - [6, user_message]
      - [7, assistant_delta]
      - [8, assistant_message]
      - [9, session_completed]
    expected_jsonl_transcript_entries:
      appended_lines:
        - {seq: 5, type: session_resumed, run_id: "R2"}
        - {seq: 6, type: user_message, run_id: "R2"}
        - {seq: 8, type: assistant_message, run_id: "R2"}
        - {seq: 9, type: session_completed, run_id: "R2"}
      assertions:
        - "exactly one terminal in R1"
        - "exactly one terminal in R2"
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
      stdout_text: "R2 OK\n"
    allowed_variance: ["none"]
    failure_conditions:
      - "second terminal in R1"
      - "missing terminal in R2"

  - test_name: assistant_delta_stream_only
    cli_input: ["ccr", "-p", "hello", "--output-format", "stream-json"]
    environment_state:
      model_script:
        - {emit_delta: "he"}
        - {emit_delta: "ll"}
        - {emit_delta: "o"}
        - {emit: "assistant_message", content: "hello"}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, assistant_delta]
      - [4, assistant_delta]
      - [5, assistant_delta]
      - [6, assistant_message]
      - [7, session_completed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 1, type: session_start}
        - {seq: 2, type: user_message}
        - {seq: 6, type: assistant_message, payload: {content: "hello"}}
        - {seq: 7, type: session_completed}
      not_persisted_types: ["assistant_delta"]
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
      stream_json:
        ordered_types: ["session_start", "user_message", "assistant_delta", "assistant_delta", "assistant_delta", "assistant_message", "session_completed"]
    allowed_variance: ["none"]
    failure_conditions:
      - "any assistant_delta in jsonl"
      - "delta order mismatch"

  - test_name: event_tool_lifecycle_allow_order
    cli_input: ["ccr", "-p", "read file", "--permission-mode", "auto", "--output-format", "stream-json"]
    environment_state:
      files:
        - {path: "/tmp/ccr_ws/a.txt", content: "alpha"}
      interactive_available: true
      model_script:
        - emit_tool:
            tool_name: "Read"
            input:
              path: "/tmp/ccr_ws/a.txt"
        - {emit: "assistant_message", content: "done"}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, tool_call_requested]
      - [4, tool_permission_decided]
      - [5, tool_execution_started]
      - [6, tool_result]
      - [7, tool_execution_finished]
      - [8, assistant_delta]
      - [9, assistant_message]
      - [10, session_completed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 4, type: tool_permission_decided, payload: {decision: "allow", reason_code: "auto_safe", precedence_rank: 7}}
        - {seq: 5, type: tool_execution_started}
        - {seq: 6, type: tool_result, payload: {result: {status: "success"}}}
        - {seq: 7, type: tool_execution_finished, payload: {status: "success"}}
    expected_tool_calls:
      - {order: 1, tool_name: "Read", input: {path: "/tmp/ccr_ws/a.txt"}}
    expected_outputs:
      exit_code: 0
      stream_json:
        ordered_types: ["session_start", "user_message", "tool_call_requested", "tool_permission_decided", "tool_execution_started", "tool_result", "tool_execution_finished", "assistant_delta", "assistant_message", "session_completed"]
    allowed_variance:
      - "duration_ms may vary 0..50"
    failure_conditions:
      - "tool_result before tool_execution_started"
      - "missing tool_execution_finished"

  - test_name: event_tool_lifecycle_deny_order
    cli_input: ["ccr", "-p", "write host", "--permission-mode", "auto"]
    environment_state:
      model_script:
        - emit_tool:
            tool_name: "Write"
            input:
              path: "/etc/hosts"
              content: "x"
      interactive_available: false
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, tool_call_requested]
      - [4, tool_permission_decided]
      - [5, tool_result]
      - [6, tool_execution_finished]
      - [7, session_failed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 4, type: tool_permission_decided, payload: {decision: "deny", reason_code: "hard_boundary_path_outside_root", precedence_rank: 1}}
        - {seq: 5, type: tool_result, payload: {result: {status: "denied"}}}
        - {seq: 6, type: tool_execution_finished, payload: {status: "denied"}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 5
    allowed_variance: ["none"]
    failure_conditions:
      - "tool_execution_started emitted"
      - "wrong deny ordering"

  - test_name: event_permission_required_only_when_askable
    cli_input:
      case_a: ["ccr", "-p", "--input-format", "stream-json", "--output-format", "stream-json", "--permission-mode", "auto"]
      case_b: ["ccr", "-p", "--permission-mode", "auto"]
    environment_state:
      case_a:
        stdin_ndjson:
          - {"type": "user_message", "content": "run bash"}
          - {"type": "permission_decision", "tool_call_id": "TC1", "decision": "allow_once"}
        interactive_available: true
      case_b:
        interactive_available: false
      model_script:
        - emit_tool:
            tool_name: "Bash"
            input:
              command: "git status"
    transcript_pre_state: []
    expected_ordered_event_sequence:
      case_a:
        - [1, session_start]
        - [2, user_message]
        - [3, tool_call_requested]
        - [4, tool_permission_required]
        - [5, tool_permission_decided]
        - [6, tool_execution_started]
        - [7, tool_result]
        - [8, tool_execution_finished]
        - [9, session_completed]
      case_b:
        - [1, session_start]
        - [2, user_message]
        - [3, tool_call_requested]
        - [4, tool_permission_decided]
        - [5, tool_result]
        - [6, tool_execution_finished]
        - [7, session_failed]
    expected_jsonl_transcript_entries:
      case_a_assertions:
        - "contains tool_permission_required"
      case_b_assertions:
        - "does not contain tool_permission_required"
        - "permission_decided.reason_code == ask_unavailable"
    expected_tool_calls:
      case_a:
        - {order: 1, tool_name: "Bash", input: {command: "git status"}}
      case_b: []
    expected_outputs:
      case_a:
        exit_code: 0
      case_b:
        exit_code: 6
    allowed_variance: ["none"]
    failure_conditions:
      - "tool_permission_required emitted in case_b"
      - "missing tool_permission_required in case_a"

  - test_name: permission_precedence_hard_boundary_first
    cli_input: ["ccr", "-p", "write", "--permission-mode", "bypass"]
    environment_state:
      persistent_rules:
        - rule_id: "r1"
          effect: "allow"
          lifetime: "persistent"
          match:
            tool_name: "Write"
            path_prefix: "/etc/"
      model_script:
        - emit_tool:
            tool_name: "Write"
            input:
              path: "/etc/hosts"
              content: "x"
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, tool_call_requested]
      - [4, tool_permission_decided]
      - [5, tool_result]
      - [6, tool_execution_finished]
      - [7, session_failed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 4, type: tool_permission_decided, payload: {decision: "deny", reason_code: "hard_boundary_path_outside_root", precedence_rank: 1}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 5
    allowed_variance: ["none"]
    failure_conditions:
      - "allow granted"
      - "precedence_rank != 1"

  - test_name: permission_rule_conflict_deny_over_allow
    cli_input: ["ccr", "-p", "run", "--permission-mode", "auto"]
    environment_state:
      session_rules:
        - {rule_id: "r_allow", effect: "allow", lifetime: "session", match: {tool_name: "Bash", command_prefix: "git "}, created_seq: 1}
        - {rule_id: "r_deny", effect: "deny", lifetime: "session", match: {tool_name: "Bash", command_prefix: "git "}, created_seq: 2}
      model_script:
        - emit_tool:
            tool_name: "Bash"
            input:
              command: "git status"
      interactive_available: true
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, tool_call_requested]
      - [4, tool_permission_decided]
      - [5, tool_result]
      - [6, tool_execution_finished]
      - [7, session_failed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 4, type: tool_permission_decided, payload: {decision: "deny", reason_code: "rule_deny", matched_rule_id: "r_deny", precedence_rank: 2}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 5
    allowed_variance: ["none"]
    failure_conditions:
      - "allow chosen over deny"
      - "wrong matched_rule_id"

  - test_name: permission_rule_tiebreak_created_seq
    cli_input: ["ccr", "-p", "run", "--permission-mode", "auto", "--output-format", "stream-json", "--input-format", "stream-json"]
    environment_state:
      stdin_ndjson:
        - {"type": "user_message", "content": "run"}
        - {"type": "permission_decision", "tool_call_id": "TC1", "decision": "deny_once"}
      interactive_available: true
      session_rules:
        - {rule_id: "r_old", effect: "allow", lifetime: "session", source: "user", match: {tool_name: "Bash", command_prefix: "git "}, created_seq: 10}
        - {rule_id: "r_new", effect: "allow", lifetime: "session", source: "user", match: {tool_name: "Bash", command_prefix: "git "}, created_seq: 11}
      model_script:
        - emit_tool:
            tool_name: "Bash"
            input:
              command: "git status"
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, tool_call_requested]
      - [4, tool_permission_decided]
      - [5, tool_execution_started]
      - [6, tool_result]
      - [7, tool_execution_finished]
      - [8, session_completed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 4, type: tool_permission_decided, payload: {decision: "allow", reason_code: "rule_allow", matched_rule_id: "r_new", precedence_rank: 3}}
    expected_tool_calls:
      - {order: 1, tool_name: "Bash", input: {command: "git status"}}
    expected_outputs:
      exit_code: 0
    allowed_variance:
      - "bash output may vary; status must be success"
    failure_conditions:
      - "matched_rule_id != r_new"

  - test_name: permission_once_consumption
    cli_input: ["ccr", "-p", "twice", "--permission-mode", "auto", "--input-format", "stream-json", "--output-format", "stream-json"]
    environment_state:
      stdin_ndjson:
        - {"type": "user_message", "content": "twice"}
        - {"type": "permission_decision", "tool_call_id": "TC2", "decision": "deny_once"}
      interactive_available: true
      session_rules:
        - {rule_id: "r_once", effect: "allow", lifetime: "once", match: {request_hash: "H1"}, remaining_uses: 1, created_seq: 1}
      model_script:
        - emit_tool:
            tool_name: "Bash"
            input:
              command: "git status"
              request_hash: "H1"
        - emit_tool:
            tool_name: "Bash"
            input:
              command: "git status"
              request_hash: "H1"
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, tool_call_requested]
      - [4, tool_permission_decided]
      - [5, tool_execution_started]
      - [6, tool_result]
      - [7, tool_execution_finished]
      - [8, tool_call_requested]
      - [9, tool_permission_required]
      - [10, tool_permission_decided]
      - [11, tool_result]
      - [12, tool_execution_finished]
      - [13, session_failed]
    expected_jsonl_transcript_entries:
      assertions:
        - "seq4.permission_meta.matched_rule_id == r_once"
        - "seq4.permission_meta.rule_mutation.op == consume"
        - "seq10.permission_meta.reason_code in [mode_ask, auto_requires_user, ask_unavailable]"
    expected_tool_calls:
      - {order: 1, tool_name: "Bash", input: {command: "git status"}}
    expected_outputs:
      exit_code: 5
    allowed_variance:
      - "second decision path may be deny_once via provided input; must not reuse r_once"
    failure_conditions:
      - "r_once consumed without winning"
      - "r_once reused second time"

  - test_name: permission_session_resume_replay
    cli_input: ["ccr", "--resume", "S1", "-p", "again", "--permission-mode", "auto"]
    environment_state:
      model_script:
        - emit_tool:
            tool_name: "Bash"
            input:
              command: "pytest -q"
      interactive_available: false
    transcript_pre_state:
      - {session_id: "S1", run_id: "R1", seq: 1, type: "session_start"}
      - {session_id: "S1", run_id: "R1", seq: 2, type: "user_message"}
      - {session_id: "S1", run_id: "R1", seq: 3, type: "tool_call_requested", tool_call_id: "TC0"}
      - {session_id: "S1", run_id: "R1", seq: 4, type: "tool_permission_required"}
      - {session_id: "S1", run_id: "R1", seq: 5, type: "tool_permission_decided", permission_meta: {decision: "allow", rule_mutation: {op: "upsert", rule_id: "rs1", effect: "allow", lifetime: "session", match: {tool_name: "Bash", command_prefix: "pytest "}}}}
      - {session_id: "S1", run_id: "R1", seq: 6, type: "session_completed"}
    expected_ordered_event_sequence:
      - [7, session_resumed]
      - [8, user_message]
      - [9, tool_call_requested]
      - [10, tool_permission_decided]
      - [11, tool_execution_started]
      - [12, tool_result]
      - [13, tool_execution_finished]
      - [14, session_completed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 10, type: tool_permission_decided, payload: {decision: "allow", reason_code: "rule_allow", matched_rule_lifetime: "session"}}
    expected_tool_calls:
      - {order: 1, tool_name: "Bash", input: {command: "pytest -q"}}
    expected_outputs:
      exit_code: 0
    allowed_variance:
      - "command exit_code may vary; permission must allow via session rule"
    failure_conditions:
      - "session rule not replayed"
      - "ask_unavailable deny"

