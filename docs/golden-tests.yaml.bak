  - test_name: retry_503_then_success
    cli_input: ["ccr", "-p", "hello"]
    environment_state:
      provider_script:
        - {attempt: 1, error_http: 503}
        - {attempt: 2, error_http: 503}
        - {attempt: 3, assistant_message: "OK"}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, retry_scheduled]
      - [4, retry_scheduled]
      - [5, assistant_delta]
      - [6, assistant_message]
      - [7, session_completed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 3, type: retry_scheduled, payload: {attempt: 2, reason: "http_503"}}
        - {seq: 4, type: retry_scheduled, payload: {attempt: 3, reason: "http_503"}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
      stdout_text: "OK\n"
    allowed_variance:
      - "delay_ms deterministic from frozen jitter seed"
    failure_conditions:
      - "wrong retry count"
      - "assistant before retries"

  - test_name: retry_retry_after_short
    cli_input: ["ccr", "-p", "hello"]
    environment_state:
      provider_script:
        - {attempt: 1, error_http: 429, retry_after_ms: 3000}
        - {attempt: 2, assistant_message: "OK"}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, retry_scheduled]
      - [4, assistant_delta]
      - [5, assistant_message]
      - [6, session_completed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 3, type: retry_scheduled, payload: {attempt: 2, delay_ms: 3000, retry_after_ms: 3000}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
    allowed_variance: ["none"]
    failure_conditions:
      - "delay_ms != retry_after_ms"

  - test_name: fallback_on_529
    cli_input: ["ccr", "-p", "hello", "--model", "primary", "--fallback-model", "fallback"]
    environment_state:
      provider_script_primary:
        - {attempt: 1, error_http: 529}
      provider_script_fallback:
        - {attempt: 1, assistant_message: "OK"}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, fallback_model_selected]
      - [4, assistant_delta]
      - [5, assistant_message]
      - [6, session_completed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 3, type: fallback_model_selected, payload: {from_model: "primary", to_model: "fallback", reason: "http_529"}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
    allowed_variance: ["none"]
    failure_conditions:
      - "no fallback event"
      - "multiple fallback events in run"

  - test_name: fallback_exhaustion
    cli_input: ["ccr", "-p", "hello", "--model", "primary", "--fallback-model", "fallback"]
    environment_state:
      provider_script_primary:
        - {attempt: 1, error_http: 529}
      provider_script_fallback:
        - {attempt: 1, error_http: 503}
        - {attempt: 2, error_http: 503}
        - {attempt: 3, error_http: 503}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, fallback_model_selected]
      - [4, retry_scheduled]
      - [5, retry_scheduled]
      - [6, session_failed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 6, type: session_failed, payload: {error_code: "PROVIDER_RETRY_EXHAUSTED"}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 3
    allowed_variance: ["none"]
    failure_conditions:
      - "session_completed emitted"
      - "wrong failure code"

  - test_name: interrupt_during_stream
    cli_input: ["ccr", "-p", "--output-format", "stream-json", "--input-format", "stream-json"]
    environment_state:
      stdin_ndjson:
        - {"type": "user_message", "content": "long answer"}
        - {"type": "interrupt", "reason": "user"}
      model_script:
        - {emit_delta: "part1"}
        - {emit_delta: "part2"}
        - {wait_ms: 1000}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, assistant_delta]
      - [4, assistant_delta]
      - [5, interrupt_received]
      - [6, system_notice]
      - [7, session_failed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 5, type: interrupt_received, payload: {source: "stream-json"}}
        - {seq: 6, type: system_notice, payload: {code: "TURN_INTERRUPTED"}}
        - {seq: 7, type: session_failed, payload: {error_code: "INTERRUPTED"}}
      assertions:
        - "no assistant_message persisted"
    expected_tool_calls: []
    expected_outputs:
      exit_code: 7
      stream_json:
        ordered_types: ["session_start", "user_message", "assistant_delta", "assistant_delta", "interrupt_received", "system_notice", "session_failed"]
    allowed_variance: ["none"]
    failure_conditions:
      - "assistant_message emitted"
      - "no terminal failure"

  - test_name: interrupt_during_bash
    cli_input: ["ccr", "-p", "--permission-mode", "auto", "--input-format", "stream-json", "--output-format", "stream-json"]
    environment_state:
      stdin_ndjson:
        - {"type": "user_message", "content": "run"}
        - {"type": "permission_decision", "tool_call_id": "TC1", "decision": "allow_once"}
        - {"type": "interrupt", "reason": "user"}
      model_script:
        - emit_tool:
            tool_name: "Bash"
            input:
              command: "sleep 5"
      interactive_available: true
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, tool_call_requested]
      - [4, tool_permission_required]
      - [5, tool_permission_decided]
      - [6, tool_execution_started]
      - [7, interrupt_received]
      - [8, tool_result]
      - [9, tool_execution_finished]
      - [10, system_notice]
      - [11, session_failed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 8, type: tool_result, payload: {result: {status: "cancelled", cancelled: true}}}
        - {seq: 9, type: tool_execution_finished, payload: {status: "cancelled"}}
    expected_tool_calls:
      - {order: 1, tool_name: "Bash"}
    expected_outputs:
      exit_code: 7
    allowed_variance:
      - "cancel latency <= 3000ms"
    failure_conditions:
      - "tool left without terminal result"
      - "missing cancelled status"

  - test_name: interrupt_persistence_sequence
    cli_input: ["ccr", "-p", "--output-format", "stream-json", "--input-format", "stream-json"]
    environment_state:
      stdin_ndjson:
        - {"type": "user_message", "content": "x"}
        - {"type": "interrupt"}
      model_script:
        - {emit_delta: "x"}
        - {wait_ms: 1000}
    transcript_pre_state: []
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, user_message]
      - [3, assistant_delta]
      - [4, interrupt_received]
      - [5, system_notice]
      - [6, session_failed]
    expected_jsonl_transcript_entries:
      lines:
        - {seq: 4, type: interrupt_received}
        - {seq: 5, type: system_notice, payload: {code: "TURN_INTERRUPTED"}}
        - {seq: 6, type: session_failed, payload: {error_code: "INTERRUPTED"}, resume_meta: {interrupted_turn_open: true}}
      assertions:
        - "order exactly 4->5->6"
    expected_tool_calls: []
    expected_outputs:
      exit_code: 7
    allowed_variance: ["none"]
    failure_conditions:
      - "out-of-order interrupt records"
      - "missing resume flag"

  - test_name: resume_after_interrupt
    cli_input: ["ccr", "--resume", "S1", "-p", "continue"]
    environment_state:
      model_script:
        - {emit: "assistant_message", content: "resumed"}
    transcript_pre_state:
      - {session_id: "S1", run_id: "R1", seq: 1, type: "session_start"}
      - {session_id: "S1", run_id: "R1", seq: 2, type: "user_message"}
      - {session_id: "S1", run_id: "R1", seq: 3, type: "interrupt_received"}
      - {session_id: "S1", run_id: "R1", seq: 4, type: "system_notice", payload: {code: "TURN_INTERRUPTED"}}
      - {session_id: "S1", run_id: "R1", seq: 5, type: "session_failed", payload: {error_code: "INTERRUPTED"}, resume_meta: {interrupted_turn_open: true}}
    expected_ordered_event_sequence:
      - [6, session_resumed]
      - [7, user_message]
      - [8, assistant_delta]
      - [9, assistant_message]
      - [10, session_completed]
    expected_jsonl_transcript_entries:
      appended_lines:
        - {seq: 6, type: session_resumed, run_id: "R2"}
        - {seq: 10, type: session_completed, run_id: "R2"}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
      stdout_text: "resumed\n"
    allowed_variance: ["none"]
    failure_conditions:
      - "run_id reused"
      - "session_resumed not first in resumed run"

  - test_name: resume_unfinished_tool_reconciliation
    cli_input: ["ccr", "--resume", "S1", "-p", "continue"]
    environment_state:
      model_script:
        - {emit: "assistant_message", content: "ok"}
    transcript_pre_state:
      - {session_id: "S1", run_id: "R1", seq: 1, type: "session_start"}
      - {session_id: "S1", run_id: "R1", seq: 2, type: "user_message"}
      - {session_id: "S1", run_id: "R1", seq: 3, type: "tool_call_requested", tool_call_id: "TC1"}
      - {session_id: "S1", run_id: "R1", seq: 4, type: "tool_permission_decided", payload: {decision: "allow"}}
      - {session_id: "S1", run_id: "R1", seq: 5, type: "tool_execution_started", tool_call_id: "TC1"}
    expected_ordered_event_sequence:
      - [6, session_resumed]
      - [7, tool_result]
      - [8, tool_execution_finished]
      - [9, user_message]
      - [10, assistant_delta]
      - [11, assistant_message]
      - [12, session_completed]
    expected_jsonl_transcript_entries:
      appended_lines:
        - {seq: 7, type: tool_result, tool_call_id: "TC1", payload: {result: {status: "cancelled", cancelled: true}}}
        - {seq: 8, type: tool_execution_finished, tool_call_id: "TC1", payload: {status: "cancelled", recovered: true}}
      assertions:
        - "every started tool has terminal finished after replay"
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
    allowed_variance: ["none"]
    failure_conditions:
      - "unreconciled started tool remains"

  - test_name: continue_latest_session
    cli_input: ["ccr", "--continue", "-p", "next"]
    environment_state:
      session_index:
        - {session_id: "S1", cwd: "/tmp/ccr_ws", last_ts: "2026-01-01T00:00:01.000Z"}
        - {session_id: "S2", cwd: "/tmp/ccr_ws", last_ts: "2026-01-01T00:00:02.000Z"}
      model_script:
        - {emit: "assistant_message", content: "on S2"}
    transcript_pre_state:
      - {session_id: "S2", run_id: "R1", seq: 1, type: "session_start"}
      - {session_id: "S2", run_id: "R1", seq: 2, type: "session_completed"}
    expected_ordered_event_sequence:
      - [3, session_resumed]
      - [4, user_message]
      - [5, assistant_delta]
      - [6, assistant_message]
      - [7, session_completed]
    expected_jsonl_transcript_entries:
      target_session_id: "S2"
      appended_lines:
        - {seq: 3, type: session_resumed}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
      stdout_text: "on S2\n"
    allowed_variance: ["none"]
    failure_conditions:
      - "session S1 selected"
      - "wrong session id append"

  - test_name: fork_session_resume
    cli_input: ["ccr", "--resume", "S1", "--fork-session", "-p", "branch"]
    environment_state:
      model_script:
        - {emit: "assistant_message", content: "forked"}
    transcript_pre_state:
      - {session_id: "S1", run_id: "R1", seq: 1, type: "session_start"}
      - {session_id: "S1", run_id: "R1", seq: 2, type: "session_completed"}
    expected_ordered_event_sequence:
      - [1, session_start]
      - [2, session_resumed]
      - [3, user_message]
      - [4, assistant_delta]
      - [5, assistant_message]
      - [6, session_completed]
    expected_jsonl_transcript_entries:
      target_session_id: "S2"
      lines:
        - {seq: 1, type: session_start, payload: {cwd: "/tmp/ccr_ws"}}
        - {seq: 2, type: session_resumed, resume_meta: {resume_parent_session_id: "S1"}, payload: {forked: true}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
      stdout_text: "forked\n"
    allowed_variance: ["none"]
    failure_conditions:
      - "writes to S1"
      - "missing resume_parent_session_id"

  - test_name: transcript_tail_truncation_recovery
    cli_input: ["ccr", "--resume", "S1", "-p", "continue"]
    environment_state:
      model_script:
        - {emit: "assistant_message", content: "ok"}
    transcript_pre_state:
      raw_lines:
        - '{"schema_version":"1.0","record_id":"E1","event_id":"E1","session_id":"S1","run_id":"R1","seq":1,"type":"session_start","turn_index":0,"parent_id":null,"parent_event_id":null,"payload":{"cwd":"/tmp/ccr_ws","permission_mode":"ask","model":"m"}}'
        - '{"schema_version":"1.0","record_id":"E2","event_id":"E2","session_id":"S1","run_id":"R1","seq":2,"type":"session_completed","turn_index":0,"parent_id":"E1","parent_event_id":"E1","payload":{"status":"completed"}}'
        - '{"schema_version":"1.0","record_id":"BROKEN"'
    expected_ordered_event_sequence:
      - [3, session_resumed]
      - [4, system_notice]
      - [5, user_message]
      - [6, assistant_delta]
      - [7, assistant_message]
      - [8, session_completed]
    expected_jsonl_transcript_entries:
      assertions:
        - "loader truncates malformed trailing line only"
        - "appended seq starts at 3"
      appended_lines:
        - {seq: 4, type: system_notice, payload: {code: "TRANSCRIPT_TAIL_TRUNCATED"}}
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
    allowed_variance: ["none"]
    failure_conditions:
      - "drops valid line E2"
      - "no truncation notice"

  - test_name: transcript_schema_forward_compat
    cli_input: ["ccr", "--resume", "S1", "-p", "continue"]
    environment_state:
      model_script:
        - {emit: "assistant_message", content: "ok"}
    transcript_pre_state:
      - {schema_version: "1.1", session_id: "S1", run_id: "R1", seq: 1, type: "session_start", payload: {cwd: "/tmp/ccr_ws", permission_mode: "ask", model: "m"}, extra_new_field: "x"}
      - {schema_version: "1.1", session_id: "S1", run_id: "R1", seq: 2, type: "session_completed", payload: {status: "completed"}}
    expected_ordered_event_sequence:
      - [3, session_resumed]
      - [4, user_message]
      - [5, assistant_delta]
      - [6, assistant_message]
      - [7, session_completed]
    expected_jsonl_transcript_entries:
      appended_lines:
        - {seq: 3, type: session_resumed}
      assertions:
        - "unknown 1.x fields ignored"
    expected_tool_calls: []
    expected_outputs:
      exit_code: 0
    allowed_variance: ["none"]
    failure_conditions:
      - "loader rejects 1.1 additive fields"

  - test_name: transcript_schema_major_break
    cli_input: ["ccr", "--resume", "S1", "-p", "continue"]
    environment_state: {}
    transcript_pre_state:
      - {schema_version: "2.0", session_id: "S1", run_id: "R1", seq: 1, type: "session_start", payload: {cwd: "/tmp/ccr_ws"}}
    expected_ordered_event_sequence: []
    expected_jsonl_transcript_entries:
      lines: []
    expected_tool_calls: []
    expected_outputs:
      exit_code: 8
      stderr_text_regex: "unsupported schema major version"
    allowed_variance: ["none"]
    failure_conditions:
      - "runtime starts despite 2.x"
      - "wrong exit code"
