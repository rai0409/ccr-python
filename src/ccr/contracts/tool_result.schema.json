{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccr/tool_result.schema.json",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "error", "cancelled", "timeout", "denied"]},
    "content": {"type": "string"},
    "entries": {"type": "array", "items": {"type": "string"}},
    "matches": {"type": "array", "items": {"type": "string"}},
    "matches_order": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{"type": "string"}, {"type": "integer"}, {"type": "integer"}],
        "minItems": 3,
        "maxItems": 3
      }
    },
    "truncation": {
      "type": "object",
      "properties": {
        "bytes_returned": {"type": "integer"},
        "lines_returned": {"type": "integer"},
        "truncated": {"type": "boolean"}
      },
      "required": ["bytes_returned", "lines_returned", "truncated"],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
