{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccr/permission_decision.schema.json",
  "type": "object",
  "required": [
    "mode",
    "decision",
    "reason_code",
    "precedence_rank",
    "decision_source",
    "risk_label",
    "request_hash"
  ],
  "properties": {
    "mode": {"type": "string", "enum": ["ask", "auto", "bypass"]},
    "decision": {"type": "string", "enum": ["allow", "deny", "ask"]},
    "reason_code": {
      "type": "string",
      "enum": [
        "auto_safe",
        "hard_boundary_path_outside_root",
        "ask_unavailable",
        "mode_ask",
        "auto_requires_user",
        "session_rule_allow",
        "session_rule_deny",
        "persistent_rule_allow",
        "persistent_rule_deny"
      ]
    },
    "precedence_rank": {"type": "integer"},
    "decision_source": {"type": "string"},
    "risk_label": {"type": "string"},
    "request_hash": {"type": "string"}
  },
  "additionalProperties": true
}
