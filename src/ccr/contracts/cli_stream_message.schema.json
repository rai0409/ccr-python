{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccr/cli_stream_message.schema.json",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "content"],
      "properties": {
        "type": {"const": "user_message"},
        "content": {"type": "string"},
        "client_msg_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "tool_call_id", "decision"],
      "properties": {
        "type": {"const": "permission_decision"},
        "tool_call_id": {"type": "string"},
        "decision": {
          "type": "string",
          "enum": [
            "allow_once",
            "deny_once",
            "allow_session",
            "deny_session",
            "allow_persistent",
            "deny_persistent"
          ]
        },
        "comment": {"type": "string"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"const": "interrupt"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    }
  ]
}
